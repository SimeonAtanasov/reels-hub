{
  "name": "reels-hub-inbox",
  "version": "1.0.0",
  "description": "Reels Hub on Cloudflare: the sharing inbox and the online library (Pages Functions + D1 behind Cloudflare Access).",
  "scripts": {
    "dev": "wrangler pages dev --port 8788 --ip 127.0.0.1",
    "db:local": "node scripts/migrate-all.mjs --local",
    "db:remote": "node scripts/migrate-all.mjs --remote",
    "deploy": "wrangler pages deploy --branch main --commit-dirty=true"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  },
  "private": true
}
